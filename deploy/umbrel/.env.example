# Copy to `.env` in the stack directory (chmod 600) and fill with STRONG values.
# This file documents the vars; the real .env is gitignored and never committed.
# The superuser + seed creds live ONLY here (host-side), never in the image.

PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-to-a-long-random-string
TEST_USERNAME=you@example.com
TEST_PASSWORD=change-me-to-a-long-random-string

# Same-origin: the SPA is served by PocketBase, so it calls /api on its own host.
VITE_PB_URL=/
